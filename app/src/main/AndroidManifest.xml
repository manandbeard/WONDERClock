<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Re-arm the minute tick after a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Optional: lets the widget land exactly on the minute boundary.
         WonderClock degrades to inexact alarms when this is not granted. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Package visibility: enough to list launchable apps for the
         "open an app" tap action, without QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SHOW_ALARMS" />
        </intent>
    </queries>

    <application
        android:name=".WonderClockApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WonderClock">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.WonderClock">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Widget configuration. Opened by the launcher when a widget is
             dropped, and by the app when an existing widget is edited. -->
        <activity
            android:name=".ui.ConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/configure_widget"
            android:theme="@style/Theme.WonderClock">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- ========================= Widgets ========================= -->

        <receiver
            android:name=".widget.DigitalClockWidgetProvider"
            android:exported="true"
            android:label="@string/widget_digital_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_digital_info" />
        </receiver>

        <receiver
            android:name=".widget.AnalogClockWidgetProvider"
            android:exported="true"
            android:label="@string/widget_analog_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_analog_info" />
        </receiver>

        <receiver
            android:name=".widget.WordClockWidgetProvider"
            android:exported="true"
            android:label="@string/widget_word_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_word_info" />
        </receiver>

        <!-- ======================== Receivers ======================== -->

        <!-- Minute tick. Not exported: only our own AlarmManager fires it. -->
        <receiver
            android:name=".widget.TickReceiver"
            android:exported="false" />

        <!-- System events that invalidate what is on screen. -->
        <receiver
            android:name=".widget.SystemEventReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
                <action android:name="android.app.action.NEXT_ALARM_CLOCK_CHANGED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
