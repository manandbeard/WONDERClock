<?xml version="1.0" encoding="utf-8"?>
<!-- Two tap zones stacked over the rendered clock: the upper ~2/3 runs the
     primary action, the lower ~1/3 (where the date and extras live) runs the
     secondary one. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wc_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/wc_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="false"
        android:contentDescription="@string/widget_content_description"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/wc_tap_primary"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="66" />

        <FrameLayout
            android:id="@+id/wc_tap_secondary"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="34" />
    </LinearLayout>

</FrameLayout>
